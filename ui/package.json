{
  "name": "opticore-ui",
  "version": "1.0.0",
  "description": "OptiCore Login UI",
  "main": "main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "demo": "npm run build && electron . --demo",
